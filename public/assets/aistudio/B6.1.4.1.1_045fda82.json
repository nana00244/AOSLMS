{"indicator": {"code": "B6.1.4.1.1", "subject": "Mathematics", "level": "Basic 6", "strand": "Number", "sub_strand": "Ratios and Proportion", "content_standard": "Demonstrate understanding of the concept of ratios and its relationship to fractions and to the multiplication and division of whole numbers", "objective": "Use concrete models and pictorial representations to explain a ratio as a concept that shows the number of times one quantity can be obtained in another and write this symbolically and in its simplest form", "source_page": 155}, "spec": {"skills": [{"tag": "write_ratio", "description": "Write a ratio from a picture, model, or simple word description.", "minQuestions": 7}, {"tag": "simplify_ratio", "description": "Simplify a given ratio to its simplest form by dividing by the highest common factor.", "minQuestions": 7}, {"tag": "ratio_forms", "description": "Express a ratio in a required form (e.g., 4:12 as 1:n, or 15:20 as n:1).", "minQuestions": 6}], "difficultyPlan": "L1:5, L2:7, L3:5, L4:3", "misconceptions": ["Reversing the order of the ratio", "Thinking a ratio can only be simplified if both numbers are even", "Confusing ratio with fraction"], "needsTeacherAssessment": true}, "questions": [{"skill_tag": "write_ratio", "type": "mcq", "difficulty": 1, "stem": "A basket has 3 oranges and 5 mangoes. What is the ratio of oranges to mangoes?", "options": ["3:5", "5:3", "3:8", "8:3"], "answer": 0, "hints": ["Write the number of oranges first.", "Then write the number of mangoes."], "explanation": "Oranges : Mangoes = 3 : 5.", "misconception": "Writing 5:3 reverses the order.", "uncertain": []}, {"skill_tag": "write_ratio", "type": "mcq", "difficulty": 2, "stem": "In a class of 24 pupils, 10 are girls. What is the ratio of boys to girls in simplest form?", "options": ["7:5", "5:7", "14:10", "10:14"], "answer": 0, "hints": ["Boys = 24 − 10 = 14.", "Ratio boys:girls = 14:10."], "explanation": "Boys:girls = 14:10 = 7:5.", "misconception": "Writing 5:7 reverses the order.", "uncertain": []}, {"skill_tag": "write_ratio", "type": "mcq", "difficulty": 1, "stem": "A picture shows 4 red beads and 6 blue beads. What is the ratio of red to blue beads?", "options": ["2:3", "3:2", "4:6", "6:4"], "answer": 0, "hints": ["Red = 4, blue = 6.", "Simplify 4:6."], "explanation": "4:6 simplifies to 2:3.", "misconception": "Writing 3:2 reverses the order.", "uncertain": []}, {"skill_tag": "write_ratio", "type": "mcq", "difficulty": 2, "stem": "A boy's mass is 50 kg and his sister's mass is 45 kg. What is the ratio of the boy's mass to his sister's mass in simplest form?", "options": ["10:9", "9:10", "50:45", "45:50"], "answer": 0, "hints": ["Boy : sister = 50:45.", "Divide both by 5."], "explanation": "50:45 = 10:9.", "misconception": "Writing 9:10 reverses the order.", "uncertain": []}, {"skill_tag": "write_ratio", "type": "mcq", "difficulty": 3, "stem": "An orange drink is made from concentrate and water in the ratio 3:8. What fraction of the mixture is concentrate?", "options": ["3/11", "3/8", "8/11", "8/3"], "answer": 0, "hints": ["Total parts = 3 + 8 = 11.", "Concentrate is 3 parts out of 11."], "explanation": "Concentrate = 3/(3+8) = 3/11 of the mixture.", "misconception": "Writing 3/8 treats the ratio as a fraction of the water only.", "uncertain": []}, {"skill_tag": "write_ratio", "type": "mcq", "difficulty": 3, "stem": "A recipe uses 2 cups of rice for every 5 cups of water. What is the ratio of rice to water?", "options": ["2:5", "5:2", "2:7", "7:2"], "answer": 0, "hints": ["Rice first, water second.", "2 cups rice, 5 cups water."], "explanation": "Rice : water = 2:5.", "misconception": "Writing 5:2 reverses the order.", "uncertain": []}, {"skill_tag": "write_ratio", "type": "mcq", "difficulty": 4, "stem": "In a school, the ratio of teachers to pupils is 1:30. If there are 12 teachers, how many pupils are there?", "options": ["360", "42", "30", "12"], "answer": 0, "hints": ["1 teacher corresponds to 30 pupils.", "12 teachers correspond to 12 × 30 pupils."], "explanation": "12 × 30 = 360 pupils.", "misconception": "Adding 12 + 30 = 42.", "uncertain": []}, {"skill_tag": "simplify_ratio", "type": "mcq", "difficulty": 1, "stem": "Simplify the ratio 6:8.", "options": ["3:4", "2:4", "6:4", "4:3"], "answer": 0, "hints": ["Find the HCF of 6 and 8.", "Divide both by 2."], "explanation": "6:8 ÷ 2/2 = 3:4.", "misconception": "Stopping at 2:4 by dividing only the first term.", "uncertain": []}, {"skill_tag": "simplify_ratio", "type": "mcq", "difficulty": 2, "stem": "Simplify the ratio 15:25.", "options": ["3:5", "5:3", "15:5", "5:15"], "answer": 0, "hints": ["HCF of 15 and 25 is 5.", "Divide both by 5."], "explanation": "15:25 ÷ 5/5 = 3:5.", "misconception": "Writing 5:3 reverses the order.", "uncertain": []}, {"skill_tag": "simplify_ratio", "type": "mcq", "difficulty": 2, "stem": "Simplify the ratio 18:24.", "options": ["3:4", "4:3", "9:12", "6:8"], "answer": 0, "hints": ["HCF of 18 and 24 is 6.", "Divide both by 6."], "explanation": "18:24 ÷ 6/6 = 3:4.", "misconception": "Stopping at 9:12 by dividing only by 2.", "uncertain": []}, {"skill_tag": "simplify_ratio", "type": "mcq", "difficulty": 3, "stem": "Simplify the ratio 45:60.", "options": ["3:4", "4:3", "9:12", "15:20"], "answer": 0, "hints": ["HCF of 45 and 60 is 15.", "Divide both by 15."], "explanation": "45:60 ÷ 15/15 = 3:4.", "misconception": "Dividing only by 5 to get 9:12.", "uncertain": []}, {"skill_tag": "simplify_ratio", "type": "mcq", "difficulty": 3, "stem": "Simplify the ratio 100:250.", "options": ["2:5", "5:2", "10:25", "4:10"], "answer": 0, "hints": ["HCF of 100 and 250 is 50.", "Divide both by 50."], "explanation": "100:250 ÷ 50/50 = 2:5.", "misconception": "Dividing only by 10 to get 10:25.", "uncertain": []}, {"skill_tag": "simplify_ratio", "type": "mcq", "difficulty": 4, "stem": "Simplify the ratio 84:126.", "options": ["2:3", "3:2", "42:63", "14:21"], "answer": 0, "hints": ["HCF of 84 and 126 is 42.", "Divide both by 42."], "explanation": "84:126 ÷ 42/42 = 2:3.", "misconception": "Dividing only by 6 to get 14:21.", "uncertain": []}, {"skill_tag": "ratio_forms", "type": "mcq", "difficulty": 1, "stem": "Write 4:12 in the form 1:n.", "options": ["1:3", "1:2", "1:4", "1:12"], "answer": 0, "hints": ["Divide both terms by 4.", "4 ÷ 4 = 1; 12 ÷ 4 = ?"], "explanation": "4:12 ÷ 4/4 = 1:3.", "misconception": "Writing 1:2 by halving instead of dividing by 4.", "uncertain": []}, {"skill_tag": "ratio_forms", "type": "mcq", "difficulty": 2, "stem": "Write 15:20 in the form n:1.", "options": ["3/4:1", "1:3/4", "3:4", "1:4/3"], "answer": 0, "hints": ["Divide both terms by 20.", "15 ÷ 20 = 0.75 = 3/4."], "explanation": "15:20 ÷ 20/20 = 0.75:1 = 3/4:1.", "misconception": "Writing 3:4 instead of n:1 form.", "uncertain": []}, {"skill_tag": "ratio_forms", "type": "mcq", "difficulty": 2, "stem": "Express 8:24 in the form 1:n.", "options": ["1:3", "1:2", "1:4", "1:24"], "answer": 0, "hints": ["Divide both by 8.", "8 ÷ 8 = 1; 24 ÷ 8 = ?"], "explanation": "8:24 ÷ 8/8 = 1:3.", "misconception": "Writing 1:2 by dividing only the first term.", "uncertain": []}, {"skill_tag": "ratio_forms", "type": "mcq", "difficulty": 3, "stem": "Express 35:42 in simplest form.", "options": ["5:6", "6:5", "7:6", "5:7"], "answer": 0, "hints": ["HCF of 35 and 42 is 7.", "Divide both by 7."], "explanation": "35:42 ÷ 7/7 = 5:6.", "misconception": "Dividing only one term by 7.", "uncertain": []}, {"skill_tag": "ratio_forms", "type": "mcq", "difficulty": 3, "stem": "Write 5:35 in the form 1:n.", "options": ["1:7", "1:6", "1:5", "1:35"], "answer": 0, "hints": ["Divide both by 5.", "5 ÷ 5 = 1; 35 ÷ 5 = ?"], "explanation": "5:35 ÷ 5/5 = 1:7.", "misconception": "Writing 1:6 by subtracting 1 instead of dividing.", "uncertain": []}, {"skill_tag": "ratio_forms", "type": "mcq", "difficulty": 4, "stem": "Express 24:36 in the form n:1.", "options": ["2/3:1", "1:2/3", "2:3", "1:3/2"], "answer": 0, "hints": ["Divide both by 36.", "24 ÷ 36 = 2/3."], "explanation": "24:36 ÷ 36/36 = 2/3:1.", "misconception": "Writing 2:3 instead of n:1 form.", "uncertain": []}]}