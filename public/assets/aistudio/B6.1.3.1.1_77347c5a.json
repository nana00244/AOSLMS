{"indicator": {"code": "B6.1.3.1.1", "subject": "Mathematics", "level": "Basic 6", "strand": "Number", "sub_strand": "Fractions", "content_standard": "Demonstrate an understanding of strategies for comparing, adding, subtracting, multiplying and dividing common, decimal and percent fractions", "objective": "Compare and order a mixture of fractions: common, percent and decimal fractions (up to thousands)", "source_page": 152}, "spec": {"skills": [{"tag": "convert_to_common", "description": "Convert between common fractions, decimals, and percentages.", "minQuestions": 7}, {"tag": "compare_mixed", "description": "Compare two or more values given in different forms using <, >, or =.", "minQuestions": 7}, {"tag": "order_mixed", "description": "Arrange a mixture of common, decimal, and percent fractions in ascending or descending order.", "minQuestions": 6}], "difficultyPlan": "L1:5, L2:7, L3:5, L4:3", "misconceptions": ["Thinking 0.75 is smaller than 7% because 75 > 7", "Converting 3/4 to 0.34 instead of 0.75", "Ordering by numerator only when denominators differ"], "needsTeacherAssessment": false}, "questions": [{"skill_tag": "convert_to_common", "type": "mcq", "difficulty": 1, "stem": "Convert 3/4 to a decimal.", "options": ["0.75", "0.34", "0.43", "0.7"], "answer": 0, "hints": ["Divide 3 by 4.", "3 ÷ 4 = ?"], "explanation": "3 ÷ 4 = 0.75.", "misconception": "Reading 3/4 as 0.34 by writing the digits in order.", "uncertain": []}, {"skill_tag": "convert_to_common", "type": "mcq", "difficulty": 1, "stem": "Convert 0.6 to a percentage.", "options": ["60%", "6%", "0.6%", "600%"], "answer": 0, "hints": ["Multiply by 100.", "0.6 × 100 = ?"], "explanation": "0.6 × 100 = 60%.", "misconception": "Forgetting to multiply by 100 and writing 6%.", "uncertain": []}, {"skill_tag": "convert_to_common", "type": "mcq", "difficulty": 1, "stem": "Convert 7/10 to a percentage.", "options": ["70%", "7%", "0.7%", "700%"], "answer": 0, "hints": ["7 ÷ 10 = 0.7.", "Multiply by 100."], "explanation": "7/10 = 0.7 = 70%.", "misconception": "Writing 7% by reading the numerator only.", "uncertain": []}, {"skill_tag": "convert_to_common", "type": "mcq", "difficulty": 1, "stem": "Convert 80% to a decimal.", "options": ["0.8", "8.0", "0.08", "80.0"], "answer": 0, "hints": ["Divide by 100.", "80 ÷ 100 = ?"], "explanation": "80 ÷ 100 = 0.8.", "misconception": "Writing 0.08 by dividing by 1000.", "uncertain": []}, {"skill_tag": "convert_to_common", "type": "mcq", "difficulty": 2, "stem": "Convert 5/8 to a decimal.", "options": ["0.625", "0.58", "0.85", "0.65"], "answer": 0, "hints": ["Divide 5 by 8.", "5 ÷ 8 = ?"], "explanation": "5 ÷ 8 = 0.625.", "misconception": "Reading 5/8 as 0.58.", "uncertain": []}, {"skill_tag": "convert_to_common", "type": "mcq", "difficulty": 2, "stem": "Convert 0.125 to a percentage.", "options": ["12.5%", "125%", "1.25%", "0.125%"], "answer": 0, "hints": ["Multiply by 100.", "0.125 × 100 = ?"], "explanation": "0.125 × 100 = 12.5%.", "misconception": "Writing 1.25% by multiplying by 10.", "uncertain": []}, {"skill_tag": "convert_to_common", "type": "mcq", "difficulty": 3, "stem": "Convert 45% to a fraction in simplest form.", "options": ["9/20", "45/100", "4/5", "9/10"], "answer": 0, "hints": ["45% = 45/100.", "Divide numerator and denominator by 5."], "explanation": "45/100 ÷ 5/5 = 9/20.", "misconception": "Stopping at 45/100 without simplifying.", "uncertain": []}, {"skill_tag": "compare_mixed", "type": "mcq", "difficulty": 1, "stem": "Which symbol correctly compares 0.5 and 50%?", "options": ["=", "<", ">", "None of these"], "answer": 0, "hints": ["Convert 0.5 to a percentage.", "0.5 = 50%."], "explanation": "0.5 = 50%, so the symbol is '='.", "misconception": "Thinking 0.5 is smaller because it has fewer digits.", "uncertain": []}, {"skill_tag": "compare_mixed", "type": "mcq", "difficulty": 2, "stem": "Which symbol correctly compares 2/5 and 0.4?", "options": ["=", "<", ">", "None of these"], "answer": 0, "hints": ["Convert 2/5 to a decimal.", "2 ÷ 5 = 0.4."], "explanation": "2/5 = 0.4, so the symbol is '='.", "misconception": "Thinking 2/5 is greater because 5 > 4.", "uncertain": []}, {"skill_tag": "compare_mixed", "type": "mcq", "difficulty": 2, "stem": "Which is larger: 3/4 or 0.8?", "options": ["0.8", "3/4", "They are equal", "Cannot tell"], "answer": 0, "hints": ["Convert 3/4 to a decimal: 0.75.", "Compare 0.75 and 0.8."], "explanation": "3/4 = 0.75, and 0.8 > 0.75, so 0.8 is larger.", "misconception": "Thinking 3/4 is larger because it is written as a fraction.", "uncertain": []}, {"skill_tag": "compare_mixed", "type": "mcq", "difficulty": 1, "stem": "Which symbol correctly compares 0.05 and 5%?", "options": ["=", "<", ">", "None of these"], "answer": 0, "hints": ["Convert 0.05 to a percentage.", "0.05 × 100 = 5%."], "explanation": "0.05 = 5%, so the symbol is '='.", "misconception": "Thinking 0.05 is smaller because of the extra zero.", "uncertain": []}, {"skill_tag": "compare_mixed", "type": "mcq", "difficulty": 2, "stem": "Which is smallest: 0.4, 42%, or 2/5?", "options": ["0.4 and 2/5 are equal and smallest", "42%", "0.4", "2/5"], "answer": 0, "hints": ["Convert all to decimals: 0.4, 0.42, 0.4.", "0.4 and 2/5 are equal."], "explanation": "0.4 = 2/5 = 0.40, and 42% = 0.42, so 0.4 and 2/5 are equal and smallest.", "misconception": "Choosing 42% because it has the largest digits.", "uncertain": []}, {"skill_tag": "compare_mixed", "type": "mcq", "difficulty": 4, "stem": "Which is larger: 1/3 or 0.33?", "options": ["1/3", "0.33", "They are equal", "Cannot tell"], "answer": 0, "hints": ["1/3 = 0.333... (repeating).", "Compare 0.333... with 0.330."], "explanation": "1/3 = 0.333... and 0.33 = 0.330, so 1/3 is larger.", "misconception": "Thinking 0.33 is equal to 1/3 because they look similar.", "uncertain": []}, {"skill_tag": "compare_mixed", "type": "mcq", "difficulty": 4, "stem": "Which is larger: 5/6 or 0.83?", "options": ["5/6", "0.83", "They are equal", "Cannot tell"], "answer": 0, "hints": ["5 ÷ 6 = 0.8333...", "Compare 0.8333... with 0.8300."], "explanation": "5/6 ≈ 0.8333... and 0.83 = 0.8300, so 5/6 is larger.", "misconception": "Thinking 0.83 is larger because it has two decimal places.", "uncertain": []}, {"skill_tag": "order_mixed", "type": "mcq", "difficulty": 2, "stem": "Arrange 0.7, 65%, and 3/4 in ascending order.", "options": ["65%, 0.7, 3/4", "0.7, 65%, 3/4", "3/4, 0.7, 65%", "65%, 3/4, 0.7"], "answer": 0, "hints": ["Convert all to decimals: 0.7, 0.65, 0.75.", "Ascending means smallest to largest."], "explanation": "0.65 < 0.70 < 0.75, so 65%, 0.7, 3/4.", "misconception": "Ordering by the first digit only.", "uncertain": []}, {"skill_tag": "order_mixed", "type": "mcq", "difficulty": 2, "stem": "Arrange 1/2, 0.45, and 55% in ascending order.", "options": ["0.45, 1/2, 55%", "1/2, 0.45, 55%", "55%, 1/2, 0.45", "0.45, 55%, 1/2"], "answer": 0, "hints": ["Convert all to decimals: 0.5, 0.45, 0.55.", "Ascending: smallest first."], "explanation": "0.45 < 0.50 < 0.55, so 0.45, 1/2, 55%.", "misconception": "Thinking 55% is smaller than 1/2 because 55 > 50.", "uncertain": []}, {"skill_tag": "order_mixed", "type": "mcq", "difficulty": 2, "stem": "Arrange 0.25, 1/4, and 22% in ascending order.", "options": ["22%, 0.25 and 1/4 (equal)", "0.25, 1/4, 22%", "1/4, 0.25, 22%", "22%, 1/4, 0.25"], "answer": 0, "hints": ["0.25 = 1/4 = 25%.", "Compare 22% with 25%."], "explanation": "22% < 25% = 0.25 = 1/4, so 22%, then 0.25 and 1/4 are equal.", "misconception": "Thinking 22% is larger because it has more digits than 0.25.", "uncertain": []}, {"skill_tag": "order_mixed", "type": "mcq", "difficulty": 3, "stem": "Arrange 0.35, 1/3, and 30% in descending order.", "options": ["0.35, 1/3, 30%", "30%, 1/3, 0.35", "1/3, 0.35, 30%", "0.35, 30%, 1/3"], "answer": 0, "hints": ["Convert all to decimals: 0.35, 0.333..., 0.30.", "Descending: largest first."], "explanation": "0.35 > 0.333... > 0.30, so 0.35, 1/3, 30%.", "misconception": "Thinking 1/3 is larger than 0.35 because 3 > 3.", "uncertain": []}, {"skill_tag": "order_mixed", "type": "mcq", "difficulty": 3, "stem": "Arrange 0.6, 2/3, and 65% in ascending order.", "options": ["0.6, 65%, 2/3", "2/3, 65%, 0.6", "65%, 0.6, 2/3", "0.6, 2/3, 65%"], "answer": 0, "hints": ["Convert all to decimals: 0.6, 0.666..., 0.65.", "Ascending: smallest first."], "explanation": "0.60 < 0.65 < 0.666..., so 0.6, 65%, 2/3.", "misconception": "Thinking 2/3 is smaller than 65% because 2 < 65.", "uncertain": []}, {"skill_tag": "order_mixed", "type": "mcq", "difficulty": 4, "stem": "Arrange 0.6, 2/3, and 65% in descending order.", "options": ["2/3, 65%, 0.6", "0.6, 65%, 2/3", "65%, 2/3, 0.6", "2/3, 0.6, 65%"], "answer": 0, "hints": ["0.6 = 0.60; 65% = 0.65; 2/3 = 0.666...", "Descending: largest first."], "explanation": "0.666... > 0.65 > 0.60, so 2/3, 65%, 0.6.", "misconception": "Placing 65% before 2/3 because 65 > 2.", "uncertain": []}]}