{"indicator": {"code": "B6.2.2.1.1", "subject": "Mathematics", "level": "Basic 6", "strand": "Algebra", "sub_strand": "Algebraic Expressions", "content_standard": "Demonstrate understanding of algebraic expressions", "objective": "Demonstrate understanding of algebraic expressions as mathematical phrases that can contain letters which represent ordinary numbers and operators (like add, subtract, multiply, and divide).", "source_page": 162}, "spec": {"skills": [{"tag": "word_to_expression", "description": "Translate a phrase such as '8 times the sum of c and 7' into an algebraic expression.", "minQuestions": 8}, {"tag": "expression_value", "description": "Substitute values into an expression and calculate the result.", "minQuestions": 6}, {"tag": "perimeter_expression", "description": "Write an expression for the perimeter of a shape with letter sides.", "minQuestions": 6}], "difficultyPlan": "L1:5, L2:7, L3:5, L4:3", "misconceptions": ["Ignoring brackets (e.g., 8×c+7 instead of 8(c+7))", "Treating a letter as a label, not a number", "Adding unlike terms incorrectly"], "needsTeacherAssessment": false}, "questions": [{"skill_tag": "word_to_expression", "type": "mcq", "difficulty": 1, "stem": "Which expression means 'the sum of 8 and s'?", "options": ["8 + s", "8s", "8 − s", "s − 8"], "answer": 0, "hints": ["'Sum' means add.", "8 and s are added together."], "explanation": "The sum of 8 and s is 8 + s.", "misconception": "Choosing 8s treats 'and' as multiplication.", "uncertain": []}, {"skill_tag": "word_to_expression", "type": "mcq", "difficulty": 2, "stem": "Which expression means '8 times the sum of c and 7'?", "options": ["8(c + 7)", "8c + 7", "8 + c + 7", "8c + 7c"], "answer": 0, "hints": ["Find the sum first: c + 7.", "Then multiply the whole sum by 8."], "explanation": "The sum of c and 7 is c + 7; 8 times that is 8(c + 7).", "misconception": "Choosing 8c + 7 multiplies only c by 8, not the whole sum.", "uncertain": []}, {"skill_tag": "word_to_expression", "type": "mcq", "difficulty": 1, "stem": "Which expression means 'take away 4 from m'?", "options": ["m − 4", "4 − m", "m + 4", "4m"], "answer": 0, "hints": ["Start with m.", "Take away 4 means subtract 4."], "explanation": "m − 4.", "misconception": "Choosing 4 − m reverses the subtraction.", "uncertain": []}, {"skill_tag": "word_to_expression", "type": "mcq", "difficulty": 2, "stem": "Which expression means 'subtract 4 from 7 times g'?", "options": ["7g − 4", "4 − 7g", "7(g − 4)", "7g + 4"], "answer": 0, "hints": ["Find 7 times g first: 7g.", "Then subtract 4."], "explanation": "7 times g is 7g; subtract 4 gives 7g − 4.", "misconception": "Choosing 7(g − 4) subtracts 4 before multiplying.", "uncertain": []}, {"skill_tag": "word_to_expression", "type": "mcq", "difficulty": 2, "stem": "Which expression means '9 times the sum of 8 and q'?", "options": ["9(8 + q)", "9 × 8 + q", "9 + 8q", "72 + 9q"], "answer": 0, "hints": ["Sum of 8 and q is 8 + q.", "Multiply the whole sum by 9."], "explanation": "9 times (8 + q) is 9(8 + q).", "misconception": "Choosing 9×8+q multiplies only 8 by 9.", "uncertain": []}, {"skill_tag": "word_to_expression", "type": "mcq", "difficulty": 2, "stem": "Which expression means 'one-sixth of n is added to the product of 9 and y'?", "options": ["n/6 + 9y", "n/6 + 9 + y", "6n + 9y", "n/6 × 9y"], "answer": 0, "hints": ["One-sixth of n is n/6.", "The product of 9 and y is 9y."], "explanation": "n/6 + 9y.", "misconception": "Choosing 6n treats 'one-sixth of n' as 6n.", "uncertain": []}, {"skill_tag": "word_to_expression", "type": "mcq", "difficulty": 3, "stem": "Which expression means 'three-fourths of the sum of c and 2'?", "options": ["3/4(c + 2)", "3/4c + 2", "3/4 + c + 2", "3/4 × c + 2"], "answer": 0, "hints": ["Sum of c and 2 is c + 2.", "Take three-fourths of the whole sum."], "explanation": "3/4(c + 2).", "misconception": "Choosing 3/4c + 2 takes three-fourths of c only.", "uncertain": []}, {"skill_tag": "word_to_expression", "type": "mcq", "difficulty": 4, "stem": "Which expression means '8 divided by r'?", "options": ["8/r", "r/8", "8 − r", "8r"], "answer": 0, "hints": ["The numerator is 8.", "The denominator is r."], "explanation": "8 divided by r is 8/r.", "misconception": "Choosing r/8 reverses the division.", "uncertain": []}, {"skill_tag": "expression_value", "type": "mcq", "difficulty": 1, "stem": "Find the value of z + 7d when z = 7 and d = 4.", "options": ["35", "28", "11", "44"], "answer": 0, "hints": ["Substitute z = 7 and d = 4.", "7 + 7(4) = 7 + 28 = ?"], "explanation": "7 + 7(4) = 7 + 28 = 35.", "misconception": "Adding 7 + 7 + 4 = 18.", "uncertain": []}, {"skill_tag": "expression_value", "type": "mcq", "difficulty": 2, "stem": "Find the value of 4 − 5s + 3b when s = 6 and b = 2.", "options": ["−20", "20", "−16", "16"], "answer": 0, "hints": ["5s = 5×6 = 30; 3b = 3×2 = 6.", "4 − 30 + 6 = ?"], "explanation": "4 − 30 + 6 = −20.", "misconception": "Adding 4 + 30 + 6 = 40.", "uncertain": []}, {"skill_tag": "expression_value", "type": "mcq", "difficulty": 2, "stem": "Find the value of 8k + d when k = 2 and d = 3.", "options": ["19", "16", "13", "24"], "answer": 0, "hints": ["8k = 8×2 = 16.", "16 + 3 = ?"], "explanation": "8(2) + 3 = 16 + 3 = 19.", "misconception": "Adding 8 + 2 + 3 = 13.", "uncertain": []}, {"skill_tag": "expression_value", "type": "mcq", "difficulty": 3, "stem": "Find the value of −7 − 2b + 6 − 3r when b = 3 and r = 4.", "options": ["−19", "−13", "−25", "19"], "answer": 0, "hints": ["2b = 6; 3r = 12.", "−7 − 6 + 6 − 12 = ?"], "explanation": "−7 − 6 + 6 − 12 = −19.", "misconception": "Adding 7 + 6 + 6 + 12 = 31.", "uncertain": []}, {"skill_tag": "expression_value", "type": "mcq", "difficulty": 3, "stem": "Find the value of 7(5f − 3n) − 8 when n = 3 and f = 7.", "options": ["174", "182", "166", "190"], "answer": 0, "hints": ["5f = 35; 3n = 9.", "7(35 − 9) − 8 = 7(26) − 8 = ?"], "explanation": "7(35 − 9) − 8 = 7(26) − 8 = 182 − 8 = 174.", "misconception": "Forgetting to subtract 8: 182.", "uncertain": []}, {"skill_tag": "expression_value", "type": "mcq", "difficulty": 4, "stem": "Find the value of −5d − k/7 when k = 14 and d = 5.", "options": ["−27", "−23", "−25", "−21"], "answer": 0, "hints": ["−5d = −25; k/7 = 14/7 = 2.", "−25 − 2 = ?"], "explanation": "−5(5) − 14/7 = −25 − 2 = −27.", "misconception": "Adding 25 + 2 = 27 but keeping it positive.", "uncertain": []}, {"skill_tag": "perimeter_expression", "type": "mcq", "difficulty": 1, "stem": "A square has side length y. What expression gives its perimeter?", "options": ["4y", "y + 4", "y²", "2y"], "answer": 0, "hints": ["A square has 4 equal sides.", "Perimeter = side + side + side + side."], "explanation": "Perimeter = y + y + y + y = 4y.", "misconception": "Choosing y + 4 adds the number of sides, not the side lengths.", "uncertain": []}, {"skill_tag": "perimeter_expression", "type": "mcq", "difficulty": 2, "stem": "A rectangle has length 10 and width y. What expression gives its perimeter?", "options": ["2(10 + y)", "10 + y", "20y", "10y"], "answer": 0, "hints": ["Perimeter = 2 × (length + width).", "Length + width = 10 + y."], "explanation": "Perimeter = 2(10 + y).", "misconception": "Choosing 10 + y gives only half the perimeter.", "uncertain": []}, {"skill_tag": "perimeter_expression", "type": "mcq", "difficulty": 2, "stem": "A triangle has sides a, 2a and 8. What expression gives its perimeter?", "options": ["3a + 8", "a + 2a + 8a", "11a", "2a + 8"], "answer": 0, "hints": ["Add all three sides: a + 2a + 8.", "Combine like terms: a + 2a = 3a."], "explanation": "a + 2a + 8 = 3a + 8.", "misconception": "Choosing 11a multiplies 8 by a incorrectly.", "uncertain": []}, {"skill_tag": "perimeter_expression", "type": "mcq", "difficulty": 3, "stem": "An L-shaped figure has sides y, y, 10, y, y and 10. What expression gives its perimeter?", "options": ["4y + 20", "2y + 20", "4y + 10", "6y"], "answer": 0, "hints": ["There are four sides of length y.", "There are two sides of length 10."], "explanation": "y + y + 10 + y + y + 10 = 4y + 20.", "misconception": "Counting only two y sides: 2y + 20.", "uncertain": []}, {"skill_tag": "perimeter_expression", "type": "mcq", "difficulty": 3, "stem": "A rectangle has length (x + 3) and width x. What expression gives its perimeter?", "options": ["4x + 6", "2x + 3", "4x + 3", "2x + 6"], "answer": 0, "hints": ["Perimeter = 2[(x+3) + x].", "Simplify inside: 2x + 3; multiply by 2."], "explanation": "2[(x+3) + x] = 2(2x + 3) = 4x + 6.", "misconception": "Forgetting to double the width: 2x + 3.", "uncertain": []}, {"skill_tag": "perimeter_expression", "type": "mcq", "difficulty": 4, "stem": "A regular pentagon has side length (2m + 1). What expression gives its perimeter?", "options": ["10m + 5", "2m + 5", "10m + 1", "7m"], "answer": 0, "hints": ["A pentagon has 5 equal sides.", "Multiply (2m + 1) by 5."], "explanation": "5(2m + 1) = 10m + 5.", "misconception": "Adding 5 instead of multiplying: 2m + 5.", "uncertain": []}]}